            "content": "<!doctype html>\n<html lang=\"es\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Panel PLC</title>\n    <link rel=\"stylesheet\" href=\"/styles.css?v=5\" />\n  </head>\n  <body>\n    <main class=\"app-shell\">\n      <header class=\"topbar\">\n        <div class=\"brand\">\n          <span class=\"brand-mark\"></span>\n          <div>\n            <p>Adquisicion industrial</p>\n            <h1>Panel PLC</h1>\n          </div>\n        </div>\n        <div class=\"actions\">\n          <span id=\"syncState\" class=\"sync-pill\">Sin lectura</span>\n          <button id=\"refreshButton\" type=\"button\">\n            <span class=\"button-icon\">↻</span>\n            Actualizar\n          </button>\n        </div>\n      </header>\n\n      <section class=\"overview\" aria-label=\"Resumen operativo\">\n        <article class=\"metric-card\">\n          <span>Total tags</span>\n          <strong id=\"totalMetric\">0</strong>\n          <small id=\"visibleCount\">0 visibles</small>\n        </article>\n        <article class=\"metric-card good\">\n          <span>Lecturas GOOD</span>\n          <strong id=\"goodMetric\">0</strong>\n          <small id=\"goodPercent\">0%</small>\n        </article>\n        <article class=\"metric-card bad\">\n          <span>Bloques BAD</span>\n          <strong id=\"badMetric\">0</strong>\n          <small id=\"badPercent\">0%</small>\n        </article>\n        <article class=\"metric-card\">\n          <span>Tiempo de ciclo</span>\n          <strong id=\"durationMetric\">--</strong>\n          <small id=\"lastRead\">Sin lectura</small>\n        </article>\n      </section>\n\n      <section class=\"quality-panel\">\n        <div class=\"panel-heading\">\n          <div>\n            <h2>Calidad de adquisicion</h2>\n            <p id=\"qualitySummary\">Esperando lectura</p>\n          </div>\n          <span id=\"plcState\" class=\"plc-chip\">--</span>\n        </div>\n        <div class=\"quality-track\" aria-label=\"Distribucion de calidad\">\n          <span id=\"goodBar\" class=\"quality-good\"></span>\n          <span id=\"badBar\" class=\"quality-bad\"></span>\n        </div>\n      </section>\n\n      <section class=\"workbench\">\n        <aside class=\"side-panel\">\n          <section class=\"panel-card\">\n            <h2>Conexion</h2>\n            <dl class=\"connection-list\">\n              <div>\n                <dt>PLC</dt>\n                <dd id=\"plcEndpoint\">--</dd>\n              </div>\n              <div>\n                <dt>MQTT</dt>\n                <dd id=\"mqttState\">--</dd>\n              </div>\n              <div>\n                <dt>Estado</dt>\n                <dd id=\"runtimeState\">Listo</dd>\n              </div>\n            </dl>\n            <p id=\"errorMessage\" class=\"error\" hidden></p>\n          </section>\n\n          <section class=\"panel-card\">\n            <h2>Telemetria MQTT</h2>\n            <dl class=\"connection-list compact-list\">\n              <div>\n                <dt>Mensaje</dt>\n                <dd id=\"messageTypeState\">--</dd>\n              </div>\n              <div>\n                <dt>Seq</dt>\n                <dd id=\"seqState\">--</dd>\n              </div>\n              <div>\n                <dt>Deltas</dt>\n                <dd id=\"deltaState\">0 cambios</dd>\n              </div>\n              <div>\n                <dt>Snapshot</dt>\n                <dd id=\"snapshotState\">Esperando</dd>\n              </div>\n              <div>\n                <dt>Prox. snapshot</dt>\n                <dd id=\"snapshotTimer\">--</dd>\n              </div>\n              <div>\n                <dt>Polling</dt>\n                <dd id=\"pollTimer\">--</dd>\n              </div>\n              <div>\n                <dt>Ultimo msg</dt>\n                <dd id=\"messageAge\">--</dd>\n              </div>\n              <div>\n                <dt>Rate MQTT</dt>\n                <dd id=\"rateLimitState\">--</dd>\n              </div>\n            </dl>\n          </section>\n\n          <section class=\"panel-card\">\n            <h2>Filtros</h2>\n            <label>\n              Buscar\n              <input id=\"searchInput\" type=\"search\" placeholder=\"tag, indice o protocolo\" />\n            </label>\n            <label>\n              Calidad\n              <select id=\"qualitySelect\">\n                <option value=\"ALL\">Todas</option>\n                <option value=\"GOOD\">GOOD</option>\n                <option value=\"BAD\">BAD</option>\n              </select>\n            </label>\n          </section>\n\n          <section class=\"panel-card\">\n            <div class=\"panel-heading compact\">\n              <h2>Bloques con error</h2>\n              <span id=\"badBlockCount\">0</span>\n            </div>\n            <ol id=\"badBlocks\" class=\"bad-list\">\n              <li>No hay bloques con error.</li>\n            </ol>\n          </section>\n        </aside>\n\n        //Tabla de datos adquiridos, con scroll independiente para manejar grandes cantidades de tags \n        // sin afectar la visibilidad de los paneles laterales o el resumen operativo.\n\n        <section class=\"table-section\" aria-label=\"Datos adquiridos\">\n          <div class=\"table-header\">\n            <div>\n              <h2>Tags adquiridos</h2>\n              <p id=\"tableSubtitle\">Sin datos cargados</p>\n            </div>\n          </div>\n          <div class=\"table-wrap\">\n            <table>\n              <thead>\n                <tr>\n                  <th>Calidad</th>\n                  <th>Tag</th>\n                  <th>Valor</th>\n                  <th>Indice</th>\n                  <th>Tipo</th>\n                  <th>Hora</th>\n                </tr>\n              </thead>\n              <tbody id=\"dataBody\">\n                <tr>\n                  <td colspan=\"6\" class=\"empty\">Cargando lectura...</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </section>\n      </section>\n    </main>\n\n    <script src=\"/socket.io/socket.io.js\"></script>\n    <script src=\"/app.js?v=6\"></script>\n  </body>\n</html>\n"
        }
    ]
}